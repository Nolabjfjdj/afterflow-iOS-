{
    "geode": "5.11.2",
    "gd": {
        "win": "2.2081",
        "mac": "2.2081",
        "ios": "2.2081"
    },
    "id": "afterflow.prsevend",
    "name": "Afterflow",
    "version": "v2.1.6",
    "developer": "prsevend",
    "description": "a predictive input cheat that fixes your early clicks and makes them accurate.",
    "tags": [
        "gameplay",
        "utility",
        "developer"
    ],
    "settings": {
        "terminal-title": {
            "type": "title",
            "name": "terminal",
            "description": "terminal window options",
            "platforms": [
                "win",
                "mac"
            ]
        },
        "terminal-enabled": {
            "type": "bool",
            "name": "enable terminal",
            "description": "allow the terminal key to open the afterflow log window",
            "default": true,
            "platforms": [
                "win",
                "mac"
            ]
        },
        "ios-controls-title": {
            "type": "title",
            "name": "iOS controls",
            "description": "touch-accessible controls for iPhone and iPad",
            "platforms": [
                "ios"
            ]
        },
        "ios-stage": {
            "type": "int",
            "name": "prediction stage",
            "description": "select the prediction delay stage on iOS (0-7, 7 disables prediction)",
            "default": 0,
            "min": 0,
            "max": 7,
            "platforms": [
                "ios"
            ]
        },
        "keybinds-title": {
            "type": "title",
            "name": "keybinds",
            "description": "change geodes keybinding anytime for afterflow",
            "platforms": [
                "win",
                "mac"
            ]
        },
        "keybind-stage": {
            "type": "keybind",
            "name": "cycle stages",
            "description": "cycle prediction stages",
            "category": "gameplay",
            "default": [
                "F6"
            ],
            "platforms": [
                "win",
                "mac"
            ]
        },
        "keybind-terminal": {
            "type": "keybind",
            "name": "terminal",
            "description": "open or close the afterflow terminal",
            "category": "universal",
            "default": [
                "F9"
            ],
            "platforms": [
                "win",
                "mac"
            ]
        }
    }
}
